# ===========================================================================
# AOAI Chat — environment overrides
# Copy to .env (gitignored) to override defaults. The Settings UI also persists
# values to .aoai-chat/config.json, which takes precedence over this file.
# ===========================================================================

# Azure OpenAI endpoint (required on first run; can also be set in Settings UI)
AOAI_ENDPOINT=https://aoai-l-eastus2.openai.azure.com/
# Foundry sample alias: ENDPOINT_URL=https://aoai-l-eastus2.openai.azure.com/

# Default deployment name (Settings UI overrides this)
AOAI_DEPLOYMENT=gpt-5.6-sol
# Foundry sample alias: DEPLOYMENT_NAME=gpt-5.6-sol

# AOAI API version
AOAI_API_VERSION=2025-01-01-preview

# Local server bind
AOAI_HOST=127.0.0.1
AOAI_PORT=8765

# Token scope: try ai.azure.com first (new), fall back to cognitiveservices.
# Leave empty for the default chain.
# AOAI_TOKEN_SCOPE=https://ai.azure.com/.default

# Transcript save directory (defaults to <repo>/conversations/)
# AOAI_SAVE_DIR=

# Auto-open browser at startup (1 / 0)
AOAI_OPEN_BROWSER=1

# Dev mode: enables hot reload, skips browser-open, expects Vite on :5173
# AOAI_DEV=1

# Request timeouts (seconds) for the streaming OpenAI client.
# `read` is the gap *between* chunks, not total stream time — AOAI sends
# keepalive events ~every 15s during long reasoning, so total stream can
# run for hours as long as no single quiet gap exceeds this value.
# Increase if you're running gpt-5.4-pro / o3-pro on xhigh-effort prompts
# and seeing read-timeout errors.
# AOAI_READ_TIMEOUT=1800
# AOAI_CONNECT_TIMEOUT=15
